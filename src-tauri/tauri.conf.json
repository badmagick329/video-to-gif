{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "video-to-gif",
  "version": "0.2.1",
  "identifier": "ink.mgck.video-to-gif",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "video-to-gif",
        "width": 1280,
        "height": 800,
        "minWidth": 1100,
        "minHeight": 700
      }
    ],
    "security": {
      "csp": null,
      "assetProtocol": {
        "enable": true,
        "scope": []
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "publisher": "mgck",
    "copyright": "Copyright (c) 2026 mgck",
    "category": "Video",
    "shortDescription": "Turn videos into GIF, WebP and MP4 with your own ffmpeg",
    "longDescription": "A desktop app that turns a video into GIF, WebP or MP4 by running the ffmpeg and ffprobe on your PATH. Trim, crop, resize, change speed and direction, and add captions, then see each file's size before you export.",
    "windows": {
      "webviewInstallMode": {
        "type": "downloadBootstrapper",
        "silent": true
      },
      "nsis": {
        "installMode": "currentUser",
        "installerIcon": "icons/icon.ico"
      }
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
